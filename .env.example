# ── Razorpay (test mode) ───────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
# pending — needs a live URL before the webhook can be registered
RAZORPAY_WEBHOOK_SECRET=

# ── Database (Neon, ap-southeast-1) ────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── LLM ────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Jobs ───────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Cache (pending — Postgres counters used as fallback) ───────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Channels (pending) ─────────────────────────────────────────────
RESEND_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── App ────────────────────────────────────────────────────────────
OPERATOR_EMAIL=
OPERATOR_ACCESS_KEY=
JWT_SECRET=
# NEVER CHANGE AFTER THE FIRST RUN — arm assignment is derived from this
ARM_ASSIGNMENT_SALT=
DEMO_RECIPIENT_PHONE=
DEMO_RECIPIENT_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Feature flags ──────────────────────────────────────────────────
FEATURE_BANDIT=false
FEATURE_VOICE=false
FEATURE_SUBSCRIPTIONS=true
FEATURE_INVOICES=false

# ── Demo merchant identity ──────────────────────────────────────────
# Appears in every customer-facing message and on the Razorpay payment page.
MERCHANT_NAME=Kiraana Fresh
MERCHANT_DESCRIPTOR=online grocery, Bengaluru
